/**
 * Security-focused TypeScript configuration for the backend server build.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2021",
    "lib": ["ES2021"],
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/app/**/*.ts",
    "src/shared/lib/securityLogger.ts",
    "src/shared/lib/sentry.ts",
    "src/shared/middleware/security.ts"
  ],
  "exclude": ["**/*.test.ts", "tests"]
}
