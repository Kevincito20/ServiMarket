#!/usr/bin/env sh
# /** Security pre-push hook for secret scanning. */
. "$(dirname -- "$0")/_/husky.sh"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --no-git --config .gitleaks.toml --source . --redact
  exit $?
fi

if command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$(pwd)":/repo zricethezav/gitleaks:v8.18.4 detect --no-git --source /repo --config /repo/.gitleaks.toml --redact
  exit $?
fi

echo "gitleaks is not installed and Docker is unavailable. Please install gitleaks or Docker to proceed."
exit 1
